{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "deploymentId": {
      "type": "string",
      "defaultValue": "[newGuid()]",
      "metadata": {
        "description": "GUID for the deployment"
      }
    },
    "configurationZipFileName": {
      "type": "string",
      "defaultValue": "https://wvdportalstorageblob.blob.core.windows.net/galleryartifacts/Configuration_1.0.02790.438.zip",
      "metadata": {
        "description": "The name of the configuration zip file used to install the agent."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[deployment().location]",
      "metadata": {
        "description": "Region where the resources will be created."
      }
    },
    "marketplaceGalleryImageSKU": {
      "type": "string",
      "defaultValue": "win11-24h2-avd-m365",
      "metadata": {
        "description": "(Required when vmImageType = Gallery) Gallery image SKU."
      }
    },
    "securityPrincipalObjectIds": {
      "type": "array",
      "metadata": {
        "description": "The object IDs of the Security Principals to assign to the AVD Application Group."
      }
    },
    "timestamp": {
      "type": "string",
      "defaultValue": "[utcNow('yyMMddHHmm')]",
      "metadata": {
        "description": "The timestamp used to name reources uniquely."
      }
    },
    "virtualMachineSize": {
      "type": "string",
      "defaultValue": "Standard_D4ds_v4",
      "metadata": {
        "description": "The size of the session host VMs."
      }
    },
    "virtualMachineLocalAdministratorAccountPassword": {
      "type": "securestring",
      "metadata": {
        "description": "The password for the local administrator account on the virtual machine."
      }
    },
    "virtualMachineLocalAdministratorAccountUsername": {
      "type": "string",
      "metadata": {
        "description": "The username for the local administrator account on the virtual machine."
      }
    },
    "defaultOutboundAccess": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Whether to enable default outbound access for the subnet."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2020-10-01",
      "name": "[format('rg-avd-quickstart-{0}', parameters('deploymentId'))]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('virtualNetwork-{0}', parameters('deploymentId'))]",
      "resourceGroup": "[format('rg-avd-quickstart-{0}', parameters('deploymentId'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "deploymentId": {
            "value": "[parameters('deploymentId')]"
          },
          "defaultOutboundAccess": {
            "value": "[parameters('defaultOutboundAccess')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "location": {
              "type": "string"
            },
            "deploymentId": {
              "type": "string"
            },
            "defaultOutboundAccess": {
              "type": "bool"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Network/networkSecurityGroups",
              "apiVersion": "2021-02-01",
              "name": "[format('nsg-avd-quickstart-{0}', parameters('deploymentId'))]",
              "location": "[parameters('location')]",
              "properties": {
                "securityRules": []
              }
            },
            {
              "type": "Microsoft.Network/virtualNetworks",
              "apiVersion": "2021-05-01",
              "name": "[format('vnet-avd-quickstart-{0}', parameters('deploymentId'))]",
              "location": "[parameters('location')]",
              "properties": {
                "addressSpace": {
                  "addressPrefixes": [
                    "192.168.0.0/24"
                  ]
                },
                "subnets": [
                  {
                    "name": "[format('subnet-avd-quickstart-{0}', parameters('deploymentId'))]",
                    "properties": {
                      "addressPrefix": "192.168.0.0/24",
                      "networkSecurityGroup": {
                        "id": "[resourceId('Microsoft.Network/networkSecurityGroups', format('nsg-avd-quickstart-{0}', parameters('deploymentId')))]"
                      },
                      "defaultOutboundAccess": "[parameters('defaultOutboundAccess')]"
                    }
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkSecurityGroups', format('nsg-avd-quickstart-{0}', parameters('deploymentId')))]"
              ]
            }
          ],
          "outputs": {
            "subnetResourceId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Network/virtualNetworks', format('vnet-avd-quickstart-{0}', parameters('deploymentId'))), '2020-05-01').subnets[0].id]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', format('rg-avd-quickstart-{0}', parameters('deploymentId')))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('controlPlane-{0}', parameters('deploymentId'))]",
      "resourceGroup": "[format('rg-avd-quickstart-{0}', parameters('deploymentId'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "securityPrincipalObjectIds": {
            "value": "[parameters('securityPrincipalObjectIds')]"
          },
          "deploymentId": {
            "value": "[parameters('deploymentId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "location": {
              "type": "string"
            },
            "securityPrincipalObjectIds": {
              "type": "array"
            },
            "time": {
              "type": "string",
              "defaultValue": "[utcNow('u')]"
            },
            "deploymentId": {
              "type": "string"
            }
          },
          "variables": {
            "desktopVirtualizationUser": "1d18fff3-a72a-46b5-b4a9-0b38a3cd7e63",
            "virtualMachineUserLogin": "fb879df8-f326-4884-b1cf-06f3ad86be52"
          },
          "resources": [
            {
              "type": "Microsoft.DesktopVirtualization/hostPools",
              "apiVersion": "2023-09-05",
              "name": "[format('vdpool-avd-quickstart-{0}', parameters('deploymentId'))]",
              "location": "[parameters('location')]",
              "properties": {
                "description": "Host Pool created through the QuickStart",
                "hostPoolType": "Pooled",
                "personalDesktopAssignmentType": null,
                "maxSessionLimit": 2,
                "loadBalancerType": "BreadthFirst",
                "validationEnvironment": false,
                "preferredAppGroupType": "Desktop",
                "ring": null,
                "registrationInfo": {
                  "expirationTime": "[dateTimeAdd(parameters('time'), 'PT2H')]",
                  "registrationTokenOperation": "Update"
                },
                "vmTemplate": null,
                "customRdpProperty": "drivestoredirect:s:*;audiomode:i:0;videoplaybackmode:i:1;redirectclipboard:i:1;redirectprinters:i:1;devicestoredirect:s:*;redirectcomports:i:1;redirectsmartcards:i:1;usbdevicestoredirect:s:*;enablecredsspsupport:i:1;redirectwebauthn:i:1;use multimon:i:1;enablerdsaadauth:i:1;",
                "publicNetworkAccess": "Enabled"
              }
            },
            {
              "type": "Microsoft.DesktopVirtualization/applicationGroups",
              "apiVersion": "2023-09-05",
              "name": "[format('vdag-avd-quickstart-{0}', parameters('deploymentId'))]",
              "location": "[parameters('location')]",
              "properties": {
                "hostPoolArmPath": "[resourceId('Microsoft.DesktopVirtualization/hostPools', format('vdpool-avd-quickstart-{0}', parameters('deploymentId')))]",
                "friendlyName": "Default Desktop",
                "description": "Desktop Application Group created through the QuickStart",
                "applicationGroupType": "Desktop"
              },
              "dependsOn": [
                "[resourceId('Microsoft.DesktopVirtualization/hostPools', format('vdpool-avd-quickstart-{0}', parameters('deploymentId')))]"
              ]
            },
            {
              "type": "Microsoft.DesktopVirtualization/workspaces",
              "apiVersion": "2023-09-05",
              "name": "[format('vdws-avd-quickstart-{0}', parameters('deploymentId'))]",
              "location": "[parameters('location')]",
              "properties": {
                "applicationGroupReferences": [
                  "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', format('vdag-avd-quickstart-{0}', parameters('deploymentId')))]"
                ],
                "publicNetworkAccess": "Enabled"
              },
              "dependsOn": [
                "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', format('vdag-avd-quickstart-{0}', parameters('deploymentId')))]"
              ]
            },
            {
              "copy": {
                "name": "roleAssignment_appGroup",
                "count": "[length(parameters('securityPrincipalObjectIds'))]"
              },
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.DesktopVirtualization/applicationGroups/{0}', format('vdag-avd-quickstart-{0}', parameters('deploymentId')))]",
              "name": "[guid(parameters('securityPrincipalObjectIds')[copyIndex()], variables('desktopVirtualizationUser'), resourceId('Microsoft.DesktopVirtualization/applicationGroups', format('vdag-avd-quickstart-{0}', parameters('deploymentId'))))]",
              "properties": {
                "roleDefinitionId": "[resourceId('Microsoft.Authorization/roleDefinitions', variables('desktopVirtualizationUser'))]",
                "principalId": "[parameters('securityPrincipalObjectIds')[copyIndex()]]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', format('vdag-avd-quickstart-{0}', parameters('deploymentId')))]"
              ]
            },
            {
              "copy": {
                "name": "roleAssignment_resourceGroup",
                "count": "[length(parameters('securityPrincipalObjectIds'))]"
              },
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(parameters('securityPrincipalObjectIds')[copyIndex()], variables('virtualMachineUserLogin'), resourceGroup().id)]",
              "properties": {
                "roleDefinitionId": "[resourceId('Microsoft.Authorization/roleDefinitions', variables('virtualMachineUserLogin'))]",
                "principalId": "[parameters('securityPrincipalObjectIds')[copyIndex()]]"
              }
            }
          ],
          "outputs": {
            "hostpoolName": {
              "type": "string",
              "value": "[format('vdpool-avd-quickstart-{0}', parameters('deploymentId'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', format('rg-avd-quickstart-{0}', parameters('deploymentId')))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('sessionHosts-{0}', parameters('timestamp'))]",
      "resourceGroup": "[format('rg-avd-quickstart-{0}', parameters('deploymentId'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "configurationZipFileName": {
            "value": "[parameters('configurationZipFileName')]"
          },
          "hostpoolName": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-avd-quickstart-{0}', parameters('deploymentId'))), 'Microsoft.Resources/deployments', format('controlPlane-{0}', parameters('deploymentId'))), '2022-09-01').outputs.hostpoolName.value]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "marketplaceGalleryImageSKU": {
            "value": "[parameters('marketplaceGalleryImageSKU')]"
          },
          "rdshVmSize": {
            "value": "[parameters('virtualMachineSize')]"
          },
          "subnetResourceId": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-avd-quickstart-{0}', parameters('deploymentId'))), 'Microsoft.Resources/deployments', format('virtualNetwork-{0}', parameters('deploymentId'))), '2022-09-01').outputs.subnetResourceId.value]"
          },
          "deploymentId": {
            "value": "[parameters('deploymentId')]"
          },
          "timestamp": {
            "value": "[parameters('timestamp')]"
          },
          "vmAdministratorAccountPassword": {
            "value": "[parameters('virtualMachineLocalAdministratorAccountPassword')]"
          },
          "vmAdministratorAccountUsername": {
            "value": "[parameters('virtualMachineLocalAdministratorAccountUsername')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "configurationZipFileName": {
              "type": "string"
            },
            "hostpoolName": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "marketplaceGalleryImageSKU": {
              "type": "string"
            },
            "rdshVmSize": {
              "type": "string"
            },
            "subnetResourceId": {
              "type": "string"
            },
            "deploymentId": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            },
            "vmAdministratorAccountUsername": {
              "type": "string"
            },
            "vmAdministratorAccountPassword": {
              "type": "securestring"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Network/networkInterfaces",
              "apiVersion": "2022-11-01",
              "name": "[format('nic-avd-quickstart-{0}', parameters('deploymentId'))]",
              "location": "[parameters('location')]",
              "properties": {
                "ipConfigurations": [
                  {
                    "name": "ipconfig",
                    "properties": {
                      "privateIPAllocationMethod": "Dynamic",
                      "subnet": {
                        "id": "[parameters('subnetResourceId')]"
                      }
                    }
                  }
                ],
                "enableAcceleratedNetworking": true
              }
            },
            {
              "type": "Microsoft.Compute/virtualMachines",
              "apiVersion": "2022-11-01",
              "name": "[format('vmaqs{0}', parameters('timestamp'))]",
              "location": "[parameters('location')]",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "hardwareProfile": {
                  "vmSize": "[parameters('rdshVmSize')]"
                },
                "osProfile": {
                  "computerName": "[format('vmaqs{0}', parameters('timestamp'))]",
                  "adminUsername": "[parameters('vmAdministratorAccountUsername')]",
                  "adminPassword": "[parameters('vmAdministratorAccountPassword')]"
                },
                "securityProfile": {
                  "uefiSettings": {
                    "secureBootEnabled": true,
                    "vTpmEnabled": true
                  },
                  "securityType": "TrustedLaunch"
                },
                "storageProfile": {
                  "imageReference": {
                    "publisher": "MicrosoftWindowsDesktop",
                    "offer": "office-365",
                    "sku": "[parameters('marketplaceGalleryImageSKU')]",
                    "version": "latest"
                  },
                  "osDisk": {
                    "createOption": "FromImage",
                    "deleteOption": "Delete",
                    "managedDisk": {
                      "storageAccountType": "Premium_LRS"
                    }
                  }
                },
                "networkProfile": {
                  "networkInterfaces": [
                    {
                      "id": "[resourceId('Microsoft.Network/networkInterfaces', format('nic-avd-quickstart-{0}', parameters('deploymentId')))]"
                    }
                  ]
                },
                "diagnosticsProfile": {
                  "bootDiagnostics": {
                    "enabled": false
                  }
                },
                "additionalCapabilities": {
                  "hibernationEnabled": false
                },
                "licenseType": "Windows_Client"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', format('nic-avd-quickstart-{0}', parameters('deploymentId')))]"
              ]
            },
            {
              "type": "Microsoft.Compute/virtualMachines/extensions",
              "apiVersion": "2018-10-01",
              "name": "[format('{0}/{1}', format('vmaqs{0}', parameters('timestamp')), 'GuestAttestation')]",
              "location": "[parameters('location')]",
              "properties": {
                "publisher": "Microsoft.Azure.Security.WindowsAttestation",
                "type": "GuestAttestation",
                "typeHandlerVersion": "1.0",
                "autoUpgradeMinorVersion": true,
                "settings": {
                  "AttestationConfig": {
                    "MaaSettings": {
                      "maaEndpoint": "",
                      "maaTenantName": "GuestAttestation"
                    },
                    "AscSettings": {
                      "ascReportingEndpoint": "",
                      "ascReportingFrequency": ""
                    },
                    "useCustomToken": "false",
                    "disableAlerts": "false"
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines', format('vmaqs{0}', parameters('timestamp')))]"
              ]
            },
            {
              "type": "Microsoft.Compute/virtualMachines/extensions",
              "apiVersion": "2021-07-01",
              "name": "[format('{0}/{1}', format('vmaqs{0}', parameters('timestamp')), 'DSC')]",
              "location": "[parameters('location')]",
              "properties": {
                "publisher": "Microsoft.Powershell",
                "type": "DSC",
                "typeHandlerVersion": "2.73",
                "autoUpgradeMinorVersion": true,
                "settings": {
                  "modulesUrl": "[parameters('configurationZipFileName')]",
                  "configurationFunction": "Configuration.ps1\\AddSessionHost",
                  "properties": {
                    "hostPoolName": "[parameters('hostpoolName')]",
                    "registrationInfoTokenCredential": {
                      "UserName": "PLACEHOLDER_DO_NOT_USE",
                      "Password": "PrivateSettingsRef:RegistrationInfoToken"
                    },
                    "aadJoin": true,
                    "UseAgentDownloadEndpoint": true,
                    "mdmId": ""
                  }
                },
                "protectedSettings": {
                  "Items": {
                    "RegistrationInfoToken": "[listRegistrationTokens(resourceId('Microsoft.DesktopVirtualization/hostPools', parameters('hostpoolName')), '2023-09-05').value[0].token]"
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines/extensions', format('vmaqs{0}', parameters('timestamp')), 'GuestAttestation')]",
                "[resourceId('Microsoft.Compute/virtualMachines', format('vmaqs{0}', parameters('timestamp')))]"
              ]
            },
            {
              "type": "Microsoft.Compute/virtualMachines/extensions",
              "apiVersion": "2021-07-01",
              "name": "[format('{0}/{1}', format('vmaqs{0}', parameters('timestamp')), 'AADLoginForWindows')]",
              "location": "[parameters('location')]",
              "properties": {
                "publisher": "Microsoft.Azure.ActiveDirectory",
                "type": "AADLoginForWindows",
                "typeHandlerVersion": "2.0",
                "autoUpgradeMinorVersion": true,
                "settings": null
              },
              "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines/extensions', format('vmaqs{0}', parameters('timestamp')), 'DSC')]",
                "[resourceId('Microsoft.Compute/virtualMachines', format('vmaqs{0}', parameters('timestamp')))]"
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-avd-quickstart-{0}', parameters('deploymentId'))), 'Microsoft.Resources/deployments', format('controlPlane-{0}', parameters('deploymentId')))]",
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', format('rg-avd-quickstart-{0}', parameters('deploymentId')))]",
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-avd-quickstart-{0}', parameters('deploymentId'))), 'Microsoft.Resources/deployments', format('virtualNetwork-{0}', parameters('deploymentId')))]"
      ]
    }
  ]
}
