{
  "$schema": "http://schema.management.azure.com/schemas/2014-04-01-preview/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "loadBalancerName": {
      "type": "string",
      "metadata": {
        "description": "The name of the load balancer to be created."
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "The location where the resource will be deployed."
      }
    },
    "frontendIpConfigName": {
      "type": "string",
      "metadata": {
        "description": "Frontend ip config name of the load balancer to be created."
      },
      "defaultValue": ""
    },
    "backendPoolName": {
      "type": "string",
      "metadata": {
        "description": "backendPool Name of the load balancer to be created."
      },
      "defaultValue": ""
    },
    "extendedLocation": {
      "type": "object",
      "metadata": {
        "description": "The EdgeZone extended location of the session host VMs."
      },
      "defaultValue": {}
    },
    "availabilityZones": {
      "type": "array",
      "metadata": {
        "description": "The availability zones to equally distribute VMs amongst"
      },
      "defaultValue": []
    },
    "outboundRuleName": {
      "type": "string",
      "metadata": {
        "description": "Outbound rule name of load balancer"
      }
    },
    "enableTcpReset": {
      "type": "bool",
      "metadata": {
        "description": "Whether to disable tcp reset for outbound rule of the load balancer"
      },
      "defaultValue": true
    },
    "outboundRuleIdleTimeoutInMinutes": {
      "type": "int",
      "metadata": {
        "description": "Idle timeout in minutes for load balancer rules config"
      },
      "defaultValue": 4
    },
    "outboundRuleProtocol": {
      "type": "string",
      "metadata": {
        "description": "Protocol for outbound rule config"
      },
      "defaultValue": "All"
    },
    "allocatedOutboundPorts": {
      "type": "int",
      "metadata": {
        "description": "Allocated outbound ports count for load balancer rules config"
      },
      "defaultValue": 0
    }
  },
  "variables": {
    "publicIpName": "[concat(parameters('loadBalancerName'), '-publicip')]"
  },
  "resources": [
    {
      "name": "[parameters('loadBalancerName')]",
      "apiVersion": "2021-05-01",
      "type": "Microsoft.Network/loadBalancers",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "extendedLocation": "[if(empty(parameters('extendedLocation')), null(), parameters('extendedLocation'))]",
      "properties": {
        "frontendIPConfigurations": [
          {
            "name": "[parameters('frontendIpConfigName')]",
            "properties": {
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIpAddresses', variables('publicIpName'))]"
              }
            }
          }
        ],
        "backendAddressPools": [
          {
            "name": "[parameters('backendPoolName')]"
          }
        ],
        "outboundRules": [
          {
            "name": "[parameters('outboundRuleName')]",
            "properties": {
              "allocatedOutboundPorts": "[parameters('allocatedOutboundPorts')]",
              "backendAddressPool": {
                "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', parameters('loadBalancerName'), parameters('backendPoolName'))]"
              },
              "enableTcpReset": "[parameters('enableTcpReset')]",
              "frontendIPConfigurations": [
                {
                  "id": "[resourceId('Microsoft.Network/loadBalancers/frontendIPConfigurations', parameters('loadBalancerName'), parameters('frontendIpConfigName'))]"
                }
              ],
              "idleTimeoutInMinutes": "[parameters('outboundRuleIdleTimeoutInMinutes')]",
              "protocol": "[parameters('outboundRuleProtocol')]"
            }
          }
        ]
      },
      "dependsOn": [ "[concat('Microsoft.Network/publicIpAddresses/', variables('publicIpName'))]" ]
    },
    {
      "name": "[variables('publicIpName')]",
      "type": "Microsoft.Network/publicIpAddresses",
      "extendedLocation": "[if(empty(parameters('extendedLocation')), null(), parameters('extendedLocation'))]",
      "apiVersion": "2019-02-01",
      "location": "[parameters('location')]",
      "properties": {
        "publicIpAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4",
        "idleTimeoutInMinutes": 15
      },
      "sku": {
        "name": "Standard"
      },
      "zones": "[parameters('availabilityZones')]"
    }
  ]
}
