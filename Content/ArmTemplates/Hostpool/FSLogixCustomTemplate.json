{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "artifactsLocation": {
            "type": "string",
            "metadata": {
                "description": "The base URI where artifacts required by this template are located."
            }
        },
        "fsLogxScriptStorageBlobPath": {
            "type": "string",
            "metadata": {
                "description": "The path to the fslogix scripts."
            }
        },
        "virtualMachineInformation":{
            "type": "array",
            "metadata":{
                "description": "The list of virtual machine names and its location"
            }
        },
        "volumeType":{
            "type":"string",
            "allowedValues": ["vhd","vhdx"],
            "metadata":{
                "description": "The volume type for FSLogix configuration"
            }
        },
        "VHDLocation":{
            "type":"string",
            "metadata":{
                "description": "The VHD Location for FSLogix configuration"
            }
        },
        "ProfileType":{
            "type": "string",
            "allowedValues": ["0","1","2","3"],
            "metadata":{
                "description": "The profile type for FSLogix configuration"
            }
        },
        "sizeInMBs":{
            "type" : "string",
            "metadata":{
                "description": "The size of VHD(X) for FSLogix configuration"
            }
        },
        "reboot":{
            "type": "bool",
            "defaultValue":"[false()]",
            "metadata":{
                "description": "Boolean to determine if to reboot the VM"
            }
        },
        "timeStamp":{
            "type":"string",
            "defaultValue":"[utcNow()]"
        }
    },
    "variables":{
        "fsLogixScriptUri":"[concat(parameters('artifactsLocation'), parameters('fsLogxScriptStorageBlobPath'),'/', 'UpdateFSLogix.ps1')]"
    },
    "resources": [
        {
            "apiVersion": "2021-07-01",
            "type": "Microsoft.Compute/virtualMachines/extensions",
            "name": "[concat(parameters('virtualMachineInformation')[copyIndex()].name,'/Micorsoft.Compute.CustomScriptExtension')]",
            "location": "[parameters('virtualMachineInformation')[copyIndex()].location]",
            "properties": {
                "publisher": "Microsoft.Compute",
                "type": "CustomScriptExtension",
                "typeHandlerVersion": "1.10",
                "autoUpgradeMinorVersion": true,
                "settings": {
                    "timestamp":"[parameters('timeStamp')]",
                    "commandToExecute": "[concat('powershell -Command ', './' , parameters('fsLogxScriptStorageBlobPath'),'/UpdateFSLogix.ps1' ,' -volumeType ',parameters('volumeType'), ' -vhdLocation ',parameters('VHDLocation'), ' -profileType ',parameters('ProfileType'), ' -sizeInMb ',parameters('sizeInMBs'), ' -reboot ', if(parameters('reboot'), '$true','$false'))]",
                    "fileUris": [
                       "[variables('fsLogixScriptUri')]"
                    ]
                }
            },
            "copy":{
                "name":"virtualMachineCopy",
                "count":"[length(parameters('virtualMachineInformation'))]"
            }
        }
    ]
}