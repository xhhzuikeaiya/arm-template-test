{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "hostpoolName": {
      "type": "string",
      "metadata": {
        "description": "The name of the hostpool for adding VMs to the hostpool"
      }
    },
    "hostpoolToken": {
      "type": "string",
      "metadata": {
        "description": "The token for adding VMs to the hostpool"
      }
    },
    "vmNames": {
      "type": "array",
      "metadata": {
        "description": "The names of VMs"
      }
    },
    "locations": {
      "type": "array",
      "metadata": {
        "description": "The locations of the VMs"
      }
    },
    "artifactsLocation": {
      "type": "string",
      "metadata": {
        "description": "The base URI where artifacts required by this template are located."
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2021-07-01",
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "name": "[concat(parameters('vmNames')[copyIndex()], '/', 'Microsoft.PowerShell.DSC')]",
      "copy": {
        "name": "vmExtensionCopy",
        "count": "[length(parameters('vmNames'))]"
      },
      "location": "[parameters('locations')[copyIndex()]]",
      "properties": {
        "publisher": "Microsoft.Powershell",
        "type": "DSC",
        "typeHandlerVersion": "2.73",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "modulesUrl": "[parameters('artifactsLocation')]",
          "configurationFunction": "Configuration.ps1\\AddSessionHost",
          "properties": {
            "hostPoolName": "[parameters('hostpoolName')]",
            "registrationInfoToken": "[parameters('hostpoolToken')]",
            "aadJoin": false
          }
        }
      }
    }
  ],
  "outputs": {}
}